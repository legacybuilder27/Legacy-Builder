# Session signing secret. Set a long random value before anyone else uses a deploy.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Leave the AI settings blank to run in demo mode. No key is required.
# Demo mode still creates projects, questions, transcripts, drafts, and exports.
# AI_PROVIDER=mock
# AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional. Local development uses a sqlite file and ignores this on Netlify.
# DATABASE_PATH=data/legacy.db

# Optional force: sqlite or blobs. Netlify uses blobs automatically.
# DATA_DRIVER=

# Set to false if you run `next start` on plain http and the browser will not keep the cookie.
# SECURE_COOKIES=
